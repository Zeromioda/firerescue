# Create a local .env.production (do NOT commit)
cat > .env.production << 'EOF'
APP_NAME="FireRescue"
APP_ENV=production
APP_KEY=base64:d+AxVCR2pJ78CW4jB2LJcv6tiVKkjoKoeSVoMPZ47jk=
APP_DEBUG=false
APP_URL=http://localhost:8000
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=pgsql
DB_HOST=postgresql-wy2flbvc.internal
DB_PORT=5432
DB_DATABASE=hf_db_wy2flbvc
DB_USERNAME=hf_knb5jevypg
DB_PASSWORD=GecEZbiZDO7ph2PhO5DAtNOCPc4jxd4U
DB_SSL_MODE=prefer
HEALTH_CHECK_DB=false
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
EOF

# Build and run
docker build -t firerescue:latest .
docker run -p 8000:8000 --env-file .env.production -d --name fr_test firerescue:latest

# Watch logs in real-time
docker logs -f fr_test

# In another terminal, test health
curl -i http://localhost:8000/health

# If it hangs, inspect Laravel logs
docker exec -it fr_test bash -c "tail -n 300 storage/logs/laravel.log"